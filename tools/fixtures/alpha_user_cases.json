{
  "suite": "alpha-user-smoke",
  "cases": [
    {
      "id": "K1",
      "database": "cyberchase.db",
      "prompt": "Give me the first three episodes from season 4, in episode order.",
      "reference_sql": "SELECT * FROM episodes WHERE season=4 ORDER BY episode_in_season ASC LIMIT 3",
      "expected_shape": {
        "base_table": "episodes",
        "filters_contains": [
          {
            "column": "season",
            "operator": "=",
            "value": 4
          }
        ],
        "order_by": [
          {
            "key": "episode_in_season",
            "direction": "ASC"
          }
        ],
        "limit": 3
      },
      "ordered": true,
      "reject": false
    },
    {
      "id": "K2",
      "database": "dese.db",
      "prompt": "Which district spends the least per pupil? Give me its name and the amount.",
      "reference_sql": "SELECT districts.name, expenditures.per_pupil_expenditure FROM districts JOIN expenditures ON districts.id=expenditures.district_id WHERE expenditures.per_pupil_expenditure=(SELECT MIN(per_pupil_expenditure) FROM expenditures) ORDER BY expenditures.per_pupil_expenditure ASC LIMIT 1",
      "expected_shape": {
        "joined_tables": [
          "districts",
          "expenditures"
        ],
        "outputs_contains": [
          "districts.name",
          "expenditures.per_pupil_expenditure"
        ]
      },
      "ordered": true,
      "reject": false
    },
    {
      "id": "K3",
      "database": "moneyball.db",
      "prompt": "Show me the five tallest American-born players. Tallest first, and use last name to break ties.",
      "reference_sql": "SELECT * FROM players WHERE birth_country='USA' ORDER BY height DESC,last_name ASC LIMIT 5",
      "expected_shape": {
        "base_table": "players",
        "filters_contains": [
          {
            "column": "birth_country",
            "operator": "=",
            "value": "USA"
          }
        ],
        "order_by": [
          {
            "key": "height",
            "direction": "DESC"
          },
          {
            "key": "last_name",
            "direction": "ASC"
          }
        ],
        "limit": 5
      },
      "ordered": true,
      "reject": false
    },
    {
      "id": "K4",
      "database": "moneyball.db",
