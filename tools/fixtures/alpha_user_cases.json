      "reference_sql": "SELECT year,MAX(HR) FROM performances GROUP BY year ORDER BY MAX(HR) DESC,year ASC LIMIT 5",
      "expected_shape": {
        "base_table": "performances",
        "outputs_contains": [
          "year",
          "MAX(HR)"
        ],
        "groups": [
          "year"
        ],
        "order_by": [
          {
            "key": "max_HR",
            "direction": "DESC"
          }
        ],
        "limit": 5,
        "having_empty": true,
        "filters_empty": true
      },
      "ordered": true,
      "reject": false
